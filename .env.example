# Database Configuration
#
# Keep rewriteBatchedStatements=true on every URL below. Hibernate is configured
# to batch multi-row writes (a seat booking inserts several rows at once), and
# this is the MySQL driver flag that makes it actually send them as one round
# trip. Without it the batch settings are inert — harmless, but doing nothing.
#
# Local dev (no SSL):
DB_URL=jdbc:mysql://localhost:3306/trackngo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&rewriteBatchedStatements=true
# Aiven (or any TLS-required MySQL) — sslMode=REQUIRED instead of useSSL=false:
# DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<database>?sslMode=REQUIRED&serverTimezone=UTC&rewriteBatchedStatements=true
# AWS RDS MySQL — see backend/trackngo-backend/aws/README.md:
# DB_URL=jdbc:mysql://<rds-endpoint>:3306/trackngo?useSSL=true&requireSSL=false&serverTimezone=UTC&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Local development note: point this at localhost, not at the deployed database.
# application.yml runs Hibernate schema validation over 37 entities at every
# startup, which is milliseconds against a local MySQL and tens of seconds
# against one across the internet — paid again on every single restart.

# Hibernate schema check. Defaults to "validate" (the production database's
# schema is managed by hand-written migrations, not Hibernate). Only set this
# to "update" locally if you need Hibernate to patch a fresh/older local DB.
JPA_DDL_AUTO=validate

# JWT Configuration
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# CORS / WebSocket allowed origin(s) for browser clients (the admin dashboard).
# Comma-separate if you need more than one (e.g. a Vercel preview URL).
# Leave unset for local dev — defaults to the admin dashboard's Vite dev server.
# Native mobile clients are unaffected either way (they don't send an Origin header).
FRONTEND_URL=https://your-admin-dashboard.vercel.app

# Render provides this automatically in production — leave unset locally
# (falls back to 8080).
PORT=

# API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Sign-In — not currently wired to any endpoint; leave unset.
GOOGLE_CLIENT_ID=

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
TWILIO_DEFAULT_COUNTRY_CODE=+94

# SMS Provider (twilio or android-gateway)
SMS_PROVIDER=twilio
SMS_ANDROID_GATEWAY_URL=
SMS_ANDROID_GATEWAY_API_KEY=

# Mail (used by the admin forgot-password OTP flow via JavaMailSender).
# Leave blank in local dev: the app still boots, and the OTP code is logged
# to the console instead of being emailed (search logs for "[DEV OTP]").
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@trackngo.local

# Note: the admin forgot-password OTP flow can also deliver via SMS, reusing
# the same TWILIO_* credentials configured above. If Twilio isn't configured,
# it likewise falls back to logging the OTP code to the console.

# Stripe (Test Mode)
# Get your keys from https://dashboard.stripe.com/test/apikeys
# Required — the app fails fast at startup if these are unset.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# PayHere (optional second payment gateway; sandbox by default)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# AI Integration (OpenAI-compatible providers)
# llama-3.1-8b-instant is deprecated on Groq (404s) — use one of the models
# below instead.
AI_API_KEY=your_ai_provider_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_MODEL_TIMEOUT_SECONDS=12
AI_MODEL_FUNCTIONS_ENABLED=false
AI_MODEL_DIRECT_HTTP_ENABLED=true

# Gemini AI Integration (legacy fallback env names)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Common alternatives:
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1


# ---------------------------------------------------------------------------
# Performance tuning (all optional)
#
# Every one of these has a working default in application.yml. Set a value here
# only to move away from that default. Deployed instances can override them as
# plain environment variables without rebuilding.
# ---------------------------------------------------------------------------

# Connection pool. max-lifetime MUST stay below the database server's
# wait_timeout (SHOW VARIABLES LIKE 'wait_timeout'), or the pool will hand out
# connections the server has already closed and requests will stall on a TCP
# timeout before retrying.
# DB_POOL_MAX=15
# DB_POOL_MIN_IDLE=5
# DB_POOL_MAX_LIFETIME_MS=570000

# Tomcat request threads. Sized for a 1 vCPU / 1GB container by default. There
# is no point exceeding what the connection pool can feed, so raise this and
# DB_POOL_MAX together.
# TOMCAT_MAX_THREADS=60
# TOMCAT_MIN_SPARE_THREADS=10

# Reference-data cache (routes and their stops). Admin edits evict it
# immediately, so this TTL only backstops changes made straight in the database.
# Set to 0 to disable caching entirely.
# CACHE_REFERENCE_TTL_SECONDS=300

# Per-request user lookup cache, read only when validating an already-issued
# token — never on the login path, so a password change still applies at once.
# Role changes, status changes and deletions all evict it immediately. Set to 0
# to go back to a database read on every authenticated request.
# CACHE_USER_DETAILS_TTL_SECONDS=60

# Minimum gap between database writes of the same bus's GPS position. The live
# passenger map is served from memory and is not affected by this; the only
# reader of the stored row is the AI assistant. Set to 0 to write every fix.
# TRACKING_LOCATION_WRITE_INTERVAL_MS=15000

# Refund poller: checks every REFUND_POLL_MS while refunds are flowing, then
# backs off to one check every (poll x multiplier) once it has seen nothing for
# REFUND_IDLE_AFTER_EMPTY_POLLS in a row. Resets the moment a refund appears.
# REFUND_POLL_MS=1000
# REFUND_IDLE_AFTER_EMPTY_POLLS=5
# REFUND_IDLE_BACKOFF_MULTIPLIER=15

# Scheduler threads. Five @Scheduled methods share this pool; on a single thread
# they serialise and a slow nightly job delays the others behind it.
# SCHEDULER_POOL_SIZE=4

# Async pool for notifications, SMS, email and the GPS location write. The queue
# is unbounded on purpose, so a burst is delayed rather than dropped.
# ASYNC_CORE_SIZE=4
# ASYNC_MAX_SIZE=8

# Set to "deferred" to build Spring Data repositories on a background thread
# during startup instead of serially on the main thread. Shaves time off a cold
# boot across 15 modules. Left off by default because this app runs several
# @PostConstruct initialisers and ApplicationRunners during startup, and that
# combination is worth watching boot against a real database once before you
# rely on it.
# JPA_REPOSITORY_BOOTSTRAP_MODE=deferred

# Actuator endpoints exposed over HTTP. Only /actuator/health is public; the
# rest require an authenticated caller.
# ACTUATOR_ENDPOINTS=health,info,metrics

# Pretty-print SQL in the logs. Only has an effect when SQL logging is on.
# HIBERNATE_FORMAT_SQL=false
