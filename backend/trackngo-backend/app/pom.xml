
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.trackngo</groupId>
    <artifactId>trackngo-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <!-- 
    The App Module
    This is the main aggregator and entry point for the Modular Monolith.
    It bundles all functional modules into a single executable application.
  -->
  <artifactId>app</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- Core Spring Boot Starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!--
      Caching. Reference data (routes, buses, emergency numbers) is read on every
      app launch and changes rarely, so it is served from an in-process Caffeine
      cache instead of the database. See app/config/CacheConfig.java for the
      cache names and TTLs, and the @CacheEvict annotations on the admin write
      paths that keep them correct.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!--
      Actuator. Without it there is no way to see per-endpoint latency, startup
      cost or connection-pool health, which makes every performance change a
      guess. SecurityConfig keeps everything except /actuator/health behind
      authentication.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Development-only: restarts the application context on recompile instead of
      requiring a full JVM boot across all 15 modules. <optional>true</optional>
      keeps it out of the production fat jar, and Spring Boot disables it
      automatically when the app is started from a packaged jar.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Database Driver -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>0.4.20</version>
    </dependency>
    <dependency>
      <groupId>org.imgscalr</groupId>
      <artifactId>imgscalr-lib</artifactId>
      <version>4.2</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>3.13.1</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
      <version>3.13.1</version>
    </dependency>

    <!-- 
      Internal Project Modules
      This section includes all functional modules. In a Modular Monolith, 
      this aggregator module ensures that all logic is loaded into the 
      Spring Application Context at runtime.
    -->
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>auth-user-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>booking-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>tracking-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>driver-fleet-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>driver-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>payment-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>notification-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>complaint-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>chat-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>feedback-rating-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>admin-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>sos-module</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.trackngo</groupId>
      <artifactId>ai-agent-module</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring Boot Maven Plugin for generating the executable JAR -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.trackngo.app.TrackNGoApplication</mainClass>
          <!--
            Layered jar. Without this the runtime image ships one ~60MB jar as a
            single Docker layer, so every deploy pushes and pulls all of it even
            when only application code changed. Layers split rarely-changing
            dependencies from frequently-changing application classes, which the
            Dockerfile extracts into separate COPY layers. It also shortens cold
            start, because the JVM reads already-extracted class files instead of
            unpacking a nested jar on every boot.
          -->
          <layers>
            <enabled>true</enabled>
          </layers>
          <!--
            Excluded from the packaged jar so a production image never carries the
            devtools restart classloader. Spring Boot disables devtools in a
            packaged jar anyway; this keeps it out of the artifact entirely.
          -->
          <excludeDevtools>true</excludeDevtools>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>



