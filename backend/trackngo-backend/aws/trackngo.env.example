# Copy this to /opt/trackngo/trackngo.env ON THE INSTANCE and fill it in.
# Never commit the filled-in copy.
#
#   sudo nano /opt/trackngo/trackngo.env
#   sudo chown trackngo:trackngo /opt/trackngo/trackngo.env
#   sudo chmod 600 /opt/trackngo/trackngo.env
#
# This is a systemd EnvironmentFile, not a shell script. That means:
#   - no `export` prefixes
#   - no ${VARIABLE} expansion; write every value out in full
#   - quotes are usually unnecessary, and are taken literally if you use them
#   - `#` starts a comment

# ---------------------------------------------------------------------------
# Database - RDS MySQL, same region as this instance
# ---------------------------------------------------------------------------
# rewriteBatchedStatements=true is what makes the Hibernate batch settings in
# application.yml actually combine multi-row inserts into one round trip.
# Without it those settings do nothing at all.
DB_URL=jdbc:mysql://REPLACE-ME.rds.amazonaws.com:3306/trackngo?useSSL=true&requireSSL=false&serverTimezone=UTC&rewriteBatchedStatements=true
DB_USERNAME=admin
DB_PASSWORD=

# The port Caddy proxies to. Leave at 8080 unless you change the Caddyfile too.
PORT=8080

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Comma-separated browser origins allowed to call the API and open WebSockets.
# This is for the admin dashboard; native mobile clients send no Origin header
# and are unaffected either way.
FRONTEND_URL=https://your-admin-dashboard.vercel.app

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Optional integrations. Every one of these is blank-safe: leaving it empty
# disables that feature rather than stopping the app from starting.
# ---------------------------------------------------------------------------
# Unset => the AI assistant falls back to its deterministic responses.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Unset => SMS codes are written to the log instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Unset => OTP emails are written to the log instead of being sent.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@trackngo.local

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# ---------------------------------------------------------------------------
# Performance tuning. Every one has a working default in application.yml -
# uncomment only to move away from it. See BACKEND_PERFORMANCE_GUIDE.md.
# ---------------------------------------------------------------------------
# Connection pool. max-lifetime must stay under the server's wait_timeout;
# RDS MySQL defaults to 28800s, so the built-in 570000ms is safe as shipped.
# DB_POOL_MAX=15
# DB_POOL_MIN_IDLE=5

# Request threads. No point exceeding what the pool can feed, so raise this and
# DB_POOL_MAX together if you move to a bigger instance.
# TOMCAT_MAX_THREADS=60

# Caches. Admin writes evict them immediately; these TTLs only backstop changes
# made straight in the database. 0 disables either cache.
# CACHE_REFERENCE_TTL_SECONDS=300
# CACHE_USER_DETAILS_TTL_SECONDS=60

# Minimum gap between database writes of one bus's GPS position. The live map is
# served from memory and is unaffected. 0 writes every accepted fix.
# TRACKING_LOCATION_WRITE_INTERVAL_MS=15000
